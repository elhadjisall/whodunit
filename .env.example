# Elasticsearch (local node started with `npm run es:start`, or Elastic Cloud / Serverless)
ELASTICSEARCH_URL=http://127.0.0.1:9200
# ELASTICSEARCH_API_KEY=

# The brain. Gemini 3.6 Flash is the default.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional: Jina dense vectors (jina-embeddings-v3) + reranker for hybrid search
# JINA_API_KEY=

# Optional: fetch GitHub issues for repos with a github remote
# GITHUB_TOKEN=
