{
  "name": "whodunit",
  "version": "0.1.0",
  "description": "git bisect with a brain: an Elasticsearch-backed detective agent that finds the commit that broke your code, cites the evidence, and fixes it.",
  "type": "module",
  "bin": {
    "whodunit": "./bin/whodunit.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json && npm run build:web",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "play": "npm run build:web && tsx src/server.ts",
    "demo": "bash scripts/demo.sh",
    "demo:offline": "bash scripts/demo.sh --offline",
    "demo:snapshot": "node scripts/extract-demo-commits.mjs",
    "es:start": "bash scripts/es-local.sh start",
    "es:stop": "bash scripts/es-local.sh stop",
    "demo:generate": "tsx src/cli.ts demo generate",
    "demo:index": "tsx src/cli.ts index --repo /tmp/whodunit-demo/acme-ledger"
  },
  "keywords": [
    "git",
    "bisect",
    "elasticsearch",
    "agent",
    "debugging",
    "developer-tools"
  ],
  "license": "MIT",
  "dependencies": {
    "@elastic/elasticsearch": "^9.4.3",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.47.0",
    "openai": "^6.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^6.4.3"
  }
}
